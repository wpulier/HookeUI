 "benchmark": {
  "name": "Guide bench",
  "method": "A closed loop on a synthetic eyepiece view with the phone's shake, noise and JPEG; a simulated person follows each line (0.6 s to react, 60-140% of the asked move, a focus step per line). Eight cases: the target off in each direction near and far, out of focus either way, the phone turned a quarter, centred only. Right when done with the target within 0.15 of the radius of the centre and, when asked, sharp.",
  "code": "services/bench/guide_bench.py",
  "command": "python -m bench.guide_bench --judge model --model <arm> --seeds 2",
  "cases": 8,
  "inputs": {
   "description": "The bundled human_mitosis.png as brightfield, mirrored 3 x 3",
