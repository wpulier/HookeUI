--- /dev/null
+++ b/sam3/_device.py
@@ -0,0 +1,19 @@
+# MicroscopeMind patch: pick the accelerator instead of assuming CUDA.
+import os
+
+import torch
+
+
+def sam3_device() -> str:
+    forced = os.environ.get("SAM3_DEVICE")
+    if forced:
+        return forced
+    if torch.cuda.is_available():
+        return "cuda"
+    if torch.backends.mps.is_available():
+        return "mps"
+    return "cpu"
+
+
+def is_cuda() -> bool:
+    return sam3_device() == "cuda"
