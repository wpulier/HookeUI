{
  "type": "object",
  "required": [
    "request",
    "statement",
    "evidence",
    "dependsOn",
    "by",
    "byLabel",
    "at"
  ],
  "additionalProperties": false,
  "properties": {
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "evidence-reference.schema.json"
      }
    },
    "dependsOn": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "byLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "at": {
      "type": "number"
    },
    "limitations": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "$id": "hooke:agent/claim"
}
