{
  "type": "object",
  "required": [
    "artifact",
    "component",
    "format",
    "shape",
    "dtype",
    "values",
    "rows",
    "columns"
  ],
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "artifact-reference.schema.json"
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "format": {
      "enum": [
        "h5ad"
      ]
    },
    "shape": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "dtype": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "values": {
      "enum": [
        "counts",
        "normalized",
        "effects",
        "predictions"
      ]
    },
    "rows": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "columns": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "sparse": {
      "enum": [
        "csr",
        "csc",
        "dense"
      ]
    }
  },
  "$id": "hooke:agent/annotated-matrix"
}
