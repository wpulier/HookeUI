{
  "type": "object",
  "required": [
    "kind",
    "id",
    "session"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "workflow"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^p[a-f0-9]{32}$"
    },
    "session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    }
  },
  "$id": "hooke:agent/operation-execution"
}
