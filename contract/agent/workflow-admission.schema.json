{
  "$id": "hooke:agent/workflow-admission",
  "type": "object",
  "required": [
    "study",
    "session",
    "workflow",
    "revision",
    "inputs"
  ],
  "additionalProperties": false,
  "properties": {
    "study": {
      "type": "string",
      "pattern": "^p[a-f0-9]{32}$"
    },
    "session": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "workflow": {
      "type": "string",
      "pattern": "^p[a-f0-9]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "artifact-reference.schema.json"
      }
    },
    "bindings": {
      "type": "object",
      "description": "Named input ports mapped to exact artifact references; the frozen workflow validates names and references."
    },
    "assignment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
