{
  "$id": "hooke:agent/project-record-inclusion",
  "type": "object",
  "required": [
    "session",
    "origin",
    "dataset",
    "reviewDigest",
    "scope",
    "files",
    "bytes",
    "reference",
    "externalReferences"
  ],
  "additionalProperties": false,
  "properties": {
    "session": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "dataset": {
      "type": "string",
      "pattern": "^ds-[0-9]{8}-[0-9]{6}(-[0-9]+)?$"
    },
    "reviewDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "enum": [
        "whole-record-folder"
      ]
    },
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    },
    "reference": {
      "$ref": "artifact-reference.schema.json"
    },
    "externalReferences": {
      "enum": [
        "not-collected"
      ]
    }
  }
}
