{
  "$id": "hooke:agent/study-question",
  "type": "object",
  "required": [
    "id",
    "request",
    "question",
    "basis",
    "recipient",
    "by",
    "byLabel",
    "at",
    "answer"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^q_[a-f0-9]{32}$"
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "basis": {
      "$ref": "artifact-reference.schema.json"
    },
    "recipient": {
      "type": "object",
      "required": [
        "actor",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "pattern": "^agent:ac_[a-f0-9]{24}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "byLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "at": {
      "type": "number",
      "minimum": 0
    },
    "answer": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "statement",
        "evidence",
        "limitations",
        "by",
        "byLabel",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "artifact-reference.schema.json"
          }
        },
        "limitations": {
          "type": "string",
          "maxLength": 8000
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "byLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "at": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "materials": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "artifact-reference.schema.json"
      }
    }
  }
}
